{
  "name": "haggletown-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "near:deploy": "node scripts/near/deploy.js",
    "near:setup": "node scripts/near/setup-world.js",
    "near:status": "node scripts/near/status.js",
    "near:smoke": "node scripts/near/smoke-trade.js",
    "market:tick": "node scripts/market-tick.js"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "joi": "18.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
