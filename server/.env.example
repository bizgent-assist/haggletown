# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=4100
APP_NAME=Haggletown
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174

# ---------------------------------------------------------------- database
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/haggletown
# Optional (Windows): DNS servers for mongodb+srv lookups if Node's default fails, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ---------------------------------------------------------------- auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- email (Brevo)
# Sender must be verified in Brevo (Senders & IPs)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Haggletown

# ---------------------------------------------------------------- AI (NEAR AI Cloud, OpenAI-compatible)
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-haiku-5-5
AI_MAX_OUTPUT_TOKENS=400

# ---------------------------------------------------------------- NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Your testnet account that deploys and owns the market (its key stays in ~/.near-credentials)
OPERATOR_ACCOUNT_ID=
# Deployed market contract. Live demo: market.haggletown-2026.testnet
MARKET_CONTRACT_ID=
# JSON map of NPC slug -> FUNCTION-CALL key (written by npm run near:setup). Never a full-access key.
NPC_KEYS={}
# Seconds between NPC market ticks (restocking, NPC-to-NPC trades, price updates)
MARKET_TICK_SECONDS=60
